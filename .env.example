# Autenticação do painel (obrigatório para o login funcionar)
ADMIN_NAME="Nome do administrador"
ADMIN_EMAIL=voce@exemplo.com
# Hash scrypt no formato salt:hash. Gere com:
#   npm run auth:hash -- "sua-senha"
ADMIN_PASSWORD_HASH=
# Segredo usado para assinar o token de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

PORT=3001

# Chave da coleta automatica. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_INGEST_KEY=

# Hospedagem
# Disco persistente da plataforma (Railway: /data · Render: /var/data)
DATA_DIR=
# URL pública do painel — usada pelo script de ingestão do MCP
DASHBOARD_URL=
NODE_ENV=production
# Front em outro domínio (Vercel): URL dele, separadas por vírgula se mais de uma
CORS_ORIGIN=

# --- Meta Marketing API (integração oficial) ---
# Token de usuário do sistema, gerado no Business Manager com ads_read.
# Fica só no servidor: nunca vai ao banco, à API, ao frontend nem ao log.
META_ACCESS_TOKEN=
# Versão da Graph API (padrão v21.0)
META_API_VERSION=
# Sincronização automática
META_SYNC_ENABLED=false
META_SYNC_INTERVAL_MINUTES=60

# --- Kommo CRM (qualificacao de leads / MQL) ---
# Token de longa duracao de uma integracao privada do Kommo.
# Da leitura de todo o CRM: fica so no servidor, nunca no frontend nem no log.
KOMMO_ACCESS_TOKEN=
# Subdominio da conta: https://<isto>.kommo.com
KOMMO_SUBDOMAIN=
# Conta de anuncios que recebe os MQLs deste CRM (externalAccountId).
# Um CRM atende um cliente: apontar para varias contaria o mesmo MQL duas vezes.
KOMMO_ACCOUNT_ID=
# Faturamento anual a partir do qual o lead conta como MQL (padrao 200000)
KOMMO_MQL_THRESHOLD=
# Nome do campo de faturamento no Kommo (padrao "Faturamento anual")
KOMMO_FATURAMENTO_FIELD=

# Persistência durável (Upstash Redis, plano gratuito). Sem estas duas, no
# Render free os usuários, clientes e briefings criados pelo painel somem
# quando o servidor hiberna ou recebe deploy. Upstash → Create Database →
# aba "REST API" → copie URL e TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
