# ============================================================================
# Agente comercial IA · equipe Marlon Mattedi
# Copie para .env e preencha. Nunca faça commit do .env.
# ============================================================================

NODE_ENV=production
PORT=3333
PUBLIC_BASE_URL=https://agente.seudominio.com.br     # URL pública do backend (webhooks e voz)
PANEL_ORIGIN=https://painel.seudominio.com.br         # URL do painel (CORS)
TZ_OPERACAO=America/Sao_Paulo

# --- Banco (Supabase/Postgres) e fila (Redis) --------------------------------
STORE=prisma                                          # prisma | memory (só testes)
DATABASE_URL=postgresql://postgres:SENHA@db.xxxx.supabase.co:5432/postgres
REDIS_URL=redis://default:SENHA@host:6379
QUEUE_MODE=bullmq                                     # bullmq | memory (só testes)
WORKER_INLINE=true                                    # worker de cadências no mesmo processo

# --- Cérebro (Claude) ---------------------------------------------------------
BRAIN=claude                                          # claude | offline (contingência/testes)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=low                                  # esforço na VOZ (latência): low | medium | high
ANTHROPIC_EFFORT_WHATSAPP=medium                      # esforço no WHATSAPP: low | medium | high
ANTHROPIC_FALLBACKS=true                              # fallback do servidor em caso de recusa
AGENT_NAME=Clara                                      # nome da assistente virtual ([NOME] do prompt)
HUMAN_DELAY=true                                      # "digitando" + espera de 1,2 a 4 s entre as mensagens curtas (false nos testes)

# --- WhatsApp Cloud API (Meta, oficial) --------------------------------------
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=                                      # token de usuário do sistema (permanente)
WA_APP_SECRET=                                        # valida X-Hub-Signature-256
WA_VERIFY_TOKEN=                                      # token que você cadastra no webhook da Meta
WA_GRAPH_VERSION=v23.0
WA_TEMPLATE_LANG=pt_BR
WA_TEAM_NUMBERS=5511999990000,5511999990001           # WhatsApp interno da equipe (alertas de transferência)
WA_MARLON_NUMBER=5511999990002                        # resumo diário às 8h
RESPONDER_FORA_DO_HORARIO=true                        # responder mensagens que o lead envia entre 20h e 9h (ver COMPLIANCE.md)

# --- STT (áudio do WhatsApp e voz própria) -----------------------------------
DEEPGRAM_API_KEY=

# --- Voz ----------------------------------------------------------------------
VOICE_PROVIDER=vapi                                   # vapi | retell | twilio_streams | none
VOICE_GENDER=feminina                                 # feminina | masculina
VOICE_RECORD_CALLS=false                              # se true, a IA avisa no início que a ligação pode ser gravada
NAO_ME_PERTURBE_CHECK_URL=                            # endpoint opcional de consulta à lista Não Me Perturbe (?phone=)

# Twilio (número brasileiro; ligação ativa de oferta SÓ pelo 0303)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=+551140000000                           # receptivo e serviço (lembrete de consulta)
TWILIO_NUMBER_0303=+5503030000000                     # telemarketing ativo (obrigatório para oferta)

# Vapi (opção a)
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=                                 # número de serviço importado da Twilio
VAPI_PHONE_NUMBER_ID_0303=                            # número 0303 importado da Twilio
VAPI_VOICE_ID_FEMININA=
VAPI_VOICE_ID_MASCULINA=
VAPI_WEBHOOK_SECRET=                                  # obrigatório em produção com vapi (header x-vapi-secret)

# Retell (opção a, alternativa)
RETELL_API_KEY=
RETELL_AGENT_ID=                                      # agente com "Custom LLM" → wss://SEU_HOST/voice/retell/llm/<RETELL_LLM_SECRET>
RETELL_LLM_SECRET=                                    # segredo no caminho do WebSocket (obrigatório em produção com retell)
RETELL_FROM_NUMBER=
RETELL_FROM_NUMBER_0303=

# Twilio Media Streams + STT/TTS próprios (opção b)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_FEMININA=
ELEVENLABS_VOICE_ID_MASCULINA=

# --- Google Calendar ----------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=                          # JSON da conta de serviço (inteiro ou em base64)
GOOGLE_CALENDAR_ID=agenda-do-marlon@gmail.com         # compartilhe a agenda com o e-mail da conta de serviço
CONSULTA_DURACAO_MIN=50
CONSULTA_HORARIOS=09:00,10:00,11:00,14:00,15:00,16:00,17:00

# --- Pagamento da consulta ----------------------------------------------------
CONSULTA_PAYMENT_PROVIDER=mercadopago                 # mercadopago | manual
MERCADOPAGO_ACCESS_TOKEN=
CONSULTA_PAYMENT_LINK_MANUAL=

# --- Hotmart ------------------------------------------------------------------
HOTMART_HOTTOK=
HOTMART_PRODUCT_ID_EXPRESS=
HOTMART_PRODUCT_ID_CONTROLE2=

# --- Captura de leads (quiz/LP) e segurança ----------------------------------
LEAD_WEBHOOK_SECRET=                                  # header x-webhook-secret
JWT_SECRET=                                           # string longa e aleatória (painel)
CRON_SECRET=                                          # token do webhook da Retell (?token=); obrigatório em produção com retell
# Em produção (NODE_ENV=production, STORE=prisma) o servidor NÃO sobe sem: WA_APP_SECRET, WA_VERIFY_TOKEN,
# HOTMART_HOTTOK, LEAD_WEBHOOK_SECRET (+ VAPI_WEBHOOK_SECRET ou RETELL_LLM_SECRET/CRON_SECRET conforme a voz).

# --- Painel (Next.js) ---------------------------------------------------------
BACKEND_URL=https://agente.seudominio.com.br          # usado pelo painel para o proxy /api
