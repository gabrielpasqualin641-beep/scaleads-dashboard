{
  "name": "agente-marlon",
  "version": "1.0.0",
  "private": true,
  "description": "Agente comercial de IA (WhatsApp + voz) da equipe do psicólogo Marlon Mattedi",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "simulate": "tsx src/simulate.ts",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:scenarios": "tsx tests/runScenarios.ts",
    "test:scenarios:live": "tsx tests/runScenarios.ts --live",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "templates:sync": "tsx src/scripts/syncTemplates.ts",
    "user:create": "tsx src/scripts/createUser.ts",
    "panel:dev": "npm --prefix panel run dev",
    "panel:build": "npm --prefix panel run build",
    "demo": "tsx src/scripts/demo.ts",
    "test:all": "npm test && npm run test:scenarios",
    "postinstall": "prisma generate",
    "local": "node scripts/local.mjs",
    "whatsapp": "tsx src/scripts/whatsapp.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.0",
    "@fastify/formbody": "^9.0.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/websocket": "^11.3.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.6.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "google-auth-library": "^11.3.3",
    "ioredis": "^6.0.0",
    "luxon": "^3.7.2",
    "pg": "^8.23.1",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^6.2.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
